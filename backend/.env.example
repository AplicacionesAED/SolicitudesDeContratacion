NODE_ENV=development
PORT=3021

# Conexión a Postgres: un solo enlace (producción). Si la contraseña tiene
# caracteres especiales (@ : / # ?), van codificados en la URL.
DATABASE_URL=postgres://usuario:clave@host:5432/solicitudes_indirectos_v2
# Alternativa para dev: variables sueltas (solo se usan si no hay DATABASE_URL).
# PGHOST=
# PGPORT=5432
# PGUSER=
# PGPASSWORD=
# PGDATABASE=solicitudes_indirectos_v2
PGSSL=false

CORS_ORIGIN=http://localhost:5193
FRONTEND_URL=http://localhost:5193

JWT_SECRET=

# Debe coincidir con un redirect URI registrado en la app de Azure AD (App
# registrations > Authentication > Redirect URIs, tipo "Web").
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=http://localhost:3021/api/auth/azure/callback

# Sync de terceros con SharePoint (Fase 3) -- mismas credenciales de Azure de
# arriba, permiso de aplicación sobre Microsoft Graph.
SHAREPOINT_FILE_ID=

# Fallback opcional de login -- bcrypt hash de una master password de
# emergencia. Nunca escribir el hash con "$" sin escapar si algún día se lee
# con dotenv-expand (este proyecto usa dotenv plano, no hace falta escapar).
MASTER_KEY_HASH=

# Fase 9 -- Postgres de solicitudes-indirectos/ (la app actual), SOLO LECTURA,
# usado por scripts/importarDatosLegado.js. Nunca commitear.
LEGACY_DATABASE_URL=

# Archivos subidos (POST /upload) -> Google Drive, servidos autenticados vía
# GET /files/drive/:fileId. Misma cuenta de servicio y esquema que el HRMS.
# La cuenta de servicio debe ser editora de la carpeta raíz (idealmente en una
# Unidad Compartida). Estructura: <raíz>/_Pendientes (recién subido) y <raíz>/<Directas|Indirectas>/<consecutivo>/ (la raíz es la carpeta "1. SOLICITUDES DE CONTRATACIÓN").
# Dev local: GOOGLE_DRIVE_KEY_FILE (ruta a un .json en backend/secrets/, gitignoreado).
# Producción (Docker/Coolify): GOOGLE_DRIVE_CREDENTIALS_JSON (el .json completo).
GOOGLE_DRIVE_KEY_FILE=secrets/nombre-del-archivo.json
GOOGLE_DRIVE_CREDENTIALS_JSON=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Solo para archivos VIEJOS en disco (/files/:filename) hasta correr
# scripts/migrarArchivosADrive.js. Ya no se escribe nada nuevo aquí.
UPLOADS_DIR=
