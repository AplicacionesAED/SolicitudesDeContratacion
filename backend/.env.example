NODE_ENV=development
PORT=3021

PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=solicitudes_indirectos_v2
PGSSL=false

CORS_ORIGIN=http://localhost:5193
FRONTEND_URL=http://localhost:5193

JWT_SECRET=

# Debe coincidir con un redirect URI registrado en la app de Azure AD (App
# registrations > Authentication > Redirect URIs, tipo "Web").
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=http://localhost:3021/api/auth/azure/callback

# Sync de terceros con SharePoint (Fase 3) -- mismas credenciales de Azure de
# arriba, permiso de aplicación sobre Microsoft Graph.
SHAREPOINT_FILE_ID=

# Fallback opcional de login -- bcrypt hash de una master password de
# emergencia. Nunca escribir el hash con "$" sin escapar si algún día se lee
# con dotenv-expand (este proyecto usa dotenv plano, no hace falta escapar).
MASTER_KEY_HASH=

# Fase 9 -- Postgres de solicitudes-indirectos/ (la app actual), SOLO LECTURA,
# usado por scripts/importarDatosLegado.js. Nunca commitear.
LEGACY_DATABASE_URL=

# Fase 8 -- carpeta de archivos subidos (POST /upload, servidos vía
# GET /files/:filename, nunca estáticos). Opcional: por defecto usa
# uploads/ en la raíz de backend/ (ya en .gitignore). En producción, apuntar
# a un volumen montado persistente.
UPLOADS_DIR=
