flowchart LR
    BOR(["BORRADOR\nSOLICITANTE\ncrea y completa la solicitud"])

    subgraph ENVIO ["Envio inicial"]
        direction TB
        TEC{Solicitante es TECNICA?}
        PEND["PENDIENTE DIRECTOR TECNICO\nDIRECTOR_TECNICO aprueba o devuelve"]
        TEC -->|Si| PEND
    end

    ENV["ENVIADA\nDIRECTOR_PROYECTO asignado al frente\naproba o devuelve"]
    TRA["EN_TRAMITE_CONTRATOS\nCONTRATOS Tramite asignado al frente\ntramita, revisa o devuelve"]
    MIN["CREACION_MINUTA\nCONTRATOS Minuta asignado al frente\nRequiere al menos 1 anexo adjunto"]
    CON["EN_CONTROLES\nCualquier usuario CONTROLES\nRegistra numero de contrato Adpro"]
    APR["APROBACION_FINAL\nDIRECTOR_CONTROLES asignado al frente\nda aprobacion final"]
    FIN(["COMPLETADA"])

    DEV["DEVUELTA\nSolo el solicitante original\npuede reenviar"]
    REV["EN_REVISION\nSolo el solicitante original\npuede reenviar"]

    BOR --> TEC
    TEC -->|No| ENV
    PEND -->|APROBAR| ENV
    PEND -->|DEVOLVER + nota| DEV

    ENV -->|APROBAR_DIRECTOR| TRA
    ENV -->|DEVOLVER + nota| DEV

    TRA -->|TRAMITAR_OK| MIN
    TRA -->|REVISAR + nota| REV
    TRA -->|DEVOLVER + nota| DEV

    MIN -->|AVANZAR_CONTRATOS| CON
    CON -->|REGISTRAR_ADPRO| APR
    APR -->|APROBAR_FINAL| FIN

    DEV -. REENVIAR .-> ENV
    REV -. REENVIAR .-> ENV

    style BOR fill:#64748b,color:#fff,stroke:#475569
    style ENV fill:#2563eb,color:#fff,stroke:#1d4ed8
    style TRA fill:#7c3aed,color:#fff,stroke:#6d28d9
    style MIN fill:#7c3aed,color:#fff,stroke:#6d28d9
    style CON fill:#0891b2,color:#fff,stroke:#0e7490
    style APR fill:#0369a1,color:#fff,stroke:#075985
    style FIN fill:#16a34a,color:#fff,stroke:#15803d
    style PEND fill:#9333ea,color:#fff,stroke:#7e22ce
    style DEV fill:#dc2626,color:#fff,stroke:#b91c1c
    style REV fill:#d97706,color:#fff,stroke:#b45309